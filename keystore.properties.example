# Copy to keystore.properties (ignored by Git) to sign release builds.
# Create a key once with:
#   keytool -genkeypair -v -keystore magic-themer-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias magic-themer
# Keep the keystore and passwords backed up: updates must be signed with the same key.
storeFile=magic-themer-release.jks
storePassword=
keyAlias=magic-themer
keyPassword=
