    <!-- Dialogs -->
    <string name="dialog_unthemeable_title">HONOR non può personalizzare %1$s</string>
    <string name="dialog_unthemeable_message">Questa build è installata come %1$s, ma le sue risorse icona usano il nome %2$s. Il motore temi di HONOR applica un\'icona solo quando entrambi i nomi coincidono, quindi nessun tema può cambiarla. Una build il cui pacchetto corrisponde alle risorse (qui %2$s) può essere personalizzata.\n\nPuoi comunque scegliere un\'icona: verrà salvata nel tema, ma HONOR mostrerà quella originale dell\'app.</string>
    <string name="dialog_theme_saved_title">Tema salvato</string>
    <string name="dialog_theme_saved_body">%1$s\n\nSalvalo o copialo in Memoria interna / HONOR / Themes, poi apri Temi HONOR → Io → I miei download → Personalizza → Icone.\n\nSe il tema non appare, tocca Info app, scegli Arresto forzato, poi riapri Temi. Questo ha aggiornato l\'elenco sul Magic V5 testato.</string>
    <string name="report_verified_details">%1$s\n\nFile: %2$s\n%3$d byte verificati\nSHA-256: %4$s</string>
    <string name="report_name_unavailable">nome non disponibile</string>
    <string name="warning_provider_no_filename">Il provider non ha restituito il nome del file. Verifica che termini con %1$s.</string>
    <string name="warning_provider_bad_extension">Attenzione: il provider ha salvato un\'estensione inattesa. Rinomina %1$s in modo che termini con %2$s prima di aprire Temi HONOR.</string>
    <string name="dialog_pack_details_body">%1$s\n\n%2$d icone in catalogo · %3$d app mappate\n%4$s\n\n%5$s\n\nIntero pacchetto esporta tutte le mappature note. Le icone alternative possono essere assegnate manualmente. Gli orologi dinamici vengono esportati come icone statiche.</string>
    <string name="pack_details_no_warnings">Nessun avviso di lettura.</string>
    <string name="pack_details_extras_both">Stile di fallback e calendario dinamico supportati.</string>
    <string name="pack_details_extras_fallback">Maschera/sfondi di fallback supportati.</string>
    <string name="pack_details_extras_calendar">Icona calendario dinamica supportata.</string>
    <string name="pack_details_extras_none">Solo icone mappate statiche (nessuna maschera di fallback o calendario dinamico).</string>
    <string name="dialog_imported_theme_title">Tema importato</string>
    <string name="dialog_imported_theme_body">%1$s\n%2$d icone statiche di pacchetti\n\n%3$s</string>
    <string name="imported_theme_default_note">Gli altri moduli del tema e le configurazioni sconosciute vengono preservati al salvataggio di una copia.</string>
    <string name="dialog_guide_title">Come applicare il tema</string>
    <string name="dialog_guide_message">1. Salva o copia il file esportato in Memoria interna / HONOR / Themes.\n\n2. Apri Temi HONOR → Io → I miei download. Se il tema non appare, tocca Info app, scegli Arresto forzato e poi riapri Temi.\n\n3. Scegli Personalizza → Icone e seleziona il tuo tema. Le voci di menu possono variare per regione.\n\nApplicazione e persistenza delle icone sono confermate sul Magic V5 / MagicOS 10.0.0.168 EU testato. Le nuove esportazioni usano il layout senza sfondo confermato.\n\nQuando un pacchetto include maschere/sfondi di fallback o calendari dinamici, Magic Themer può esportarli (controlla il risultato sul telefono e disattivali nella scheda Tema se preferisci).\n\nI temi ZIP ordinari importati vengono salvati come nuova copia. Puoi modificare le icone PNG statiche e titolo, autore e descrizione; gli altri moduli e le anteprime originali restano intatti.\n\nUsa Senza icona per trovare le app scoperte o condividere l\'elenco come richiesta icone per l\'autore del pacchetto.\n\nUsa le esportazioni solo per uso personale; la grafica resta di proprietà dei rispettivi autori.</string>
    <string name="dialog_open_themes_manual_title">Apri Temi HONOR manualmente</string>
    <string name="dialog_open_themes_manual_message">Apri l\'app Temi, oppure Impostazioni → Schermata Home e personalizzazione → Temi.</string>

