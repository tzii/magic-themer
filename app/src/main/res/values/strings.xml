    <!-- Dialogs -->
    <string name="dialog_unthemeable_title">HONOR can\'t theme %1$s</string>
    <string name="dialog_unthemeable_message">This build is installed as %1$s, but its icon resources are named %2$s. HONOR\'s theme engine only applies a theme icon when both names match, so no theme can change this icon. A build whose package matches its resources (here %2$s) can be themed.\n\nYou can still choose an icon. It is saved in the theme, but HONOR shows the app\'s own icon.</string>
    <string name="dialog_theme_saved_title">Theme saved</string>
    <string name="dialog_theme_saved_body">%1$s\n\nSave or copy it to internal storage / HONOR / Themes, then open HONOR Themes → Me → My downloads → Customize → Icons.\n\nIf your theme is missing, tap App info, choose Force stop, then reopen Themes. This refreshed the list on the tested Magic V5.</string>
    <string name="report_verified_details">%1$s\n\nFile: %2$s\n%3$d bytes verified\nSHA-256: %4$s</string>
    <string name="report_name_unavailable">name unavailable</string>
    <string name="warning_provider_no_filename">The provider did not report the filename. Check that the saved name ends in %1$s.</string>
    <string name="warning_provider_bad_extension">Warning: the provider saved an unexpected extension. Rename %1$s to end in %2$s before opening HONOR Themes.</string>
    <string name="dialog_pack_details_body">%1$s\n\n%2$d catalogue icons · %3$d app mappings\n%4$s\n\n%5$s\n\nWhole icon pack exports every known app mapping. Alternative and unmapped artwork can be assigned manually. Dynamic clocks are exported as static icons.</string>
    <string name="pack_details_no_warnings">No parsing warnings.</string>
    <string name="pack_details_extras_both">Fallback styling and live calendar supported.</string>
    <string name="pack_details_extras_fallback">Fallback mask/background styling supported.</string>
    <string name="pack_details_extras_calendar">Live calendar icon supported.</string>
    <string name="pack_details_extras_none">Static mapped icons only (no fallback mask or live calendar).</string>
    <string name="dialog_imported_theme_title">Imported theme</string>
    <string name="dialog_imported_theme_body">%1$s\n%2$d static package icons\n\n%3$s</string>
    <string name="imported_theme_default_note">Other theme modules and unknown configuration are preserved when saving a copy.</string>
    <string name="dialog_guide_title">Apply your theme</string>
    <string name="dialog_guide_message">1. Save or copy the exported file to internal storage / HONOR / Themes.\n\n2. Open HONOR Themes → Me → My downloads. If your theme is missing, tap App info, choose Force stop, then reopen Themes.\n\n3. Choose Customize → Icons and select your theme. Menu labels can vary by region.\n\nIcon application and persistence are confirmed on the tested Magic V5 / MagicOS 10.0.0.168 EU. New exports use the tested wallpaper-free layout. Themes may keep an old downloads list until it is force-stopped and reopened.\n\nWhen a pack includes fallback masks/backgrounds or dynamic calendars, Magic Themer can export them too (check how they look on your phone and toggle them in the Theme tab if needed).\n\nImported ordinary ZIP themes are saved as a new copy. Static package PNGs and title, designer, and description can be edited; other modules and authored previews are preserved. Selecting a pack does not alter an imported theme until you apply the pack or assign an icon.\n\nUse Needs icon to find apps without usable artwork, or share the list as an icon request for the pack\'s author.\n\nUse exports personally; artwork remains owned by its creator.</string>
    <string name="dialog_open_themes_manual_title">Open HONOR Themes manually</string>
    <string name="dialog_open_themes_manual_message">Open the Themes app, or Settings → Home screen &amp; personalization → Themes.</string>
    <string name="dialog_same_title_title">Same theme name as original</string>
    <string name="dialog_same_title_message">HONOR Themes can hide an edited copy if it keeps the same internal name (%1$s). Use a new name so the copy appears in My downloads?</string>
